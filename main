def find_workbook():
    candidates = [
        Path("data") / "orders.xlsx",
        Path("data") / "uebungsdatensatz_data_wrangling_online_shop.xlsx",
        Path("uebungsdatensatz_data_wrangling_online_shop.xlsx"),
    ]
    return next((p for p in candidates if p.exists()), None)

def _synthetic_shop_data():
    import pandas as pd
    import numpy as np
    rng = np.random.default_rng(42)
    n_customers, n_orders = 120, 650
    ids = np.arange(1001, 1001+n_customers)
    customers = pd.DataFrame({
        "customer_id": ids,
        "name": [f"Customer {i}" for i in ids],
        "gender": rng.choice(["female","male"], n_customers),
        "age": rng.integers(18,70,n_customers),
        "city": rng.choice(["Zurich","Bern","Basel","Lucerne","Geneva"], n_customers),
        "postal_code": rng.integers(1000,9999,n_customers),
        "segment": rng.choice(["Standard","Premium","VIP"], n_customers),
        "acquisition_channel": rng.choice(["organic","social","email","paid"], n_customers),
        "registration_date": pd.date_range("2023-01-01", periods=n_customers, freq="5D"),
    })
    pids=np.arange(2001,2036)
    products=pd.DataFrame({
        "product_id":pids,
        "product_name":[f"Product {i}" for i in pids],
        "category":rng.choice(["Electronics","Home","Sport","Beauty","Books"],35),
        "brand":rng.choice(["Brand A","Brand B","Brand C"],35),
        "price_chf":np.round(rng.uniform(10,450,35),2),
        "cost_chf":np.round(rng.uniform(5,250,35),2),
        "stock":rng.integers(0,100,35)
    })
    dates=pd.to_datetime("2025-01-01")+pd.to_timedelta(rng.integers(0,365,n_orders),unit="D")
    qty=rng.integers(1,6,n_orders)
    price=rng.choice(products["price_chf"],n_orders)
    gross=np.round(qty*price,2)
    discount=np.round(rng.choice([0,0,0,5,10,15,20],n_orders),2)
    shipping=rng.choice([0,4.9,6.9],n_orders)
    net=np.round(gross-discount+shipping,2)
    orders=pd.DataFrame({
        "order_id":np.arange(500001,500001+n_orders),
        "order_date":dates,
        "customer_id":rng.choice(ids,n_orders),
        "product_id":rng.choice(pids,n_orders),
        "quantity":qty,
        "gross_amount_chf":gross,
        "promo_code":rng.choice(["","SAVE10","WELCOME","SPRING"],n_orders),
        "discount_chf":discount,
        "shipping_chf":shipping,
        "net_amount_chf":net,
        "payment_method":rng.choice(["card","paypal","twint"],n_orders),
        "status":rng.choice(["completed","completed","completed","cancelled"],n_orders),
        "shipping_city":rng.choice(["Zurich","Bern","Basel","Lucerne","Geneva"],n_orders),
        "channel":rng.choice(["web","mobile","marketplace"],n_orders)
    })
    campaigns=pd.DataFrame({
        "campaign_id":range(1,7),
        "campaign_name":[f"Campaign {i}" for i in range(1,7)],
        "start_date":pd.date_range("2025-01-01",periods=6,freq="60D"),
        "end_date":pd.date_range("2025-02-15",periods=6,freq="60D"),
        "channel":["email","social","paid","email","social","paid"],
        "target_segment":["Standard","Premium","VIP","Standard","Premium","VIP"]
    })
    return customers, products, orders, campaigns

def prepare_base_data(target_dir):
    import pandas as pd
    (target_dir/"data").mkdir(parents=True, exist_ok=True)
    wb=find_workbook()
    try:
        if wb:
            kunden=pd.read_excel(wb, sheet_name="Kunden")
            produkte=pd.read_excel(wb, sheet_name="Produkte")
            bestellungen=pd.read_excel(wb, sheet_name="Bestellungen")
            kampagnen=pd.read_excel(wb, sheet_name="Kampagnen")
        else:
            raise RuntimeError
    except Exception:
        kunden, produkte, bestellungen, kampagnen=_synthetic_shop_data()

    transactions=pd.DataFrame({
        "Customer":bestellungen["customer_id"],
        "TransDate":pd.to_datetime(bestellungen["order_date"], errors="coerce"),
        "Quantity":pd.to_numeric(bestellungen["quantity"], errors="coerce"),
        "PurchAmount":pd.to_numeric(bestellungen["net_amount_chf"], errors="coerce"),
        "Cost":pd.to_numeric(bestellungen["discount_chf"], errors="coerce").fillna(0)
              +pd.to_numeric(bestellungen["shipping_chf"], errors="coerce").fillna(0),
        "Channel":bestellungen.get("channel", pd.Series(["online"]*len(bestellungen))).astype(str)
    })
    transactions["Year"]=transactions["TransDate"].dt.year
    cust=pd.DataFrame({
        "Customer":kunden["customer_id"],
        "CustId":kunden["customer_id"],
        "Store":kunden.get("acquisition_channel", pd.Series(["online"]*len(kunden))).astype(str),
        "JoinDate":pd.to_datetime(kunden.get("registration_date"), errors="coerce")
    })

    A=pd.DataFrame({
        "ID":[1,2,3,4],
        "TransDate":pd.to_datetime(["2025-01-01","2025-01-02","2025-01-03","2025-01-04"]),
        "ValueA":[10,20,30,40]
    })
    B=pd.DataFrame({
        "ID":[2,3,4,5],
        "TransDate":pd.to_datetime(["2025-01-02","2025-01-03","2025-01-04","2025-01-05"]),
        "ValueB":[200,300,400,500]
    })

    transactions.to_csv(target_dir/"data"/"transactions.csv", index=False)
    transactions.to_csv(target_dir/"transactions.csv", index=False)
    kunden.to_csv(target_dir/"customers.csv", index=False)
    produkte.to_csv(target_dir/"products.csv", index=False)

    import sqlite3
    con=sqlite3.connect(target_dir/"database.sqlite")
    transactions.to_sql("transactions", con, if_exists="replace", index=False)
    cust.to_sql("CustData", con, if_exists="replace", index=False)
    A.to_sql("A", con, if_exists="replace", index=False)
    B.to_sql("B", con, if_exists="replace", index=False)
    A.to_sql("X", con, if_exists="replace", index=False)
    B.to_sql("Y", con, if_exists="replace", index=False)
    pd.DataFrame({"ID":[1],"Value":["demo"]}).to_sql("new_table", con, if_exists="replace", index=False)
    con.commit()
    con.close()

def adapt_code(code):
    c=code
    c=c.replace("filepath_or_buüer", '"data/transactions.csv"')
    c=c.replace("filepath_or_buffer", '"data/transactions.csv"')
    c=c.replace('path_or_buf="file.csv"', '"output.csv"')
    c=c.replace("path_or_buf='file.csv'", '"output.csv"')
    c=c.replace("package.function", "np.sum")
    c=c.replace('myData["Spalte1"]', 'myData["PurchAmount"]')
    c=c.replace('myData["Spalte2"]', 'myData["Cost"]')
    c=c.replace('myData["Spalte"]', 'myData["PurchAmount"]')
    c=c.replace('myData["column_name"]', 'myData["Customer"]')
    c=c.replace("row_index", "0")
    c=c.replace("dayﬁrst", "dayfirst")
    c=c.replace("zﬁll", "zfill")
    # Current pandas: DataFrame.append() was removed. The game uses concat only in the old append example.
    c=c.replace(
        'myData.append(pd.DataFrame([[...]], columns=myData.columns.values), ignore_index=True)',
        'myData = pd.concat([myData, pd.DataFrame([[1001, pd.Timestamp("2025-01-01"), 1, 10.0, 2.0, "web", 2025]], columns=myData.columns)], ignore_index=True)'
    )
    c=c.replace("variableName = (...)", "variableName = 42")
    # Placeholder expressions in plotting examples.
    c=re.sub(r'plt\.plot\(x,\s*y,', 'plt.plot(myData["PurchAmount"].head(20), myData["Cost"].head(20),', c)
    c=re.sub(r'plt\.text\(x,\s*y,', 'plt.text(100, 50,', c)
    c=c.replace("plt.xlim(min, max)", "plt.xlim(0,500)")
    c=c.replace("plt.ylim(min, max)", "plt.ylim(0,500)")
    stripped=c.strip()
    if stripped.startswith(("SELECT ","INSERT INTO ","ALTER TABLE ","DROP TABLE ")):
        if stripped.startswith("SELECT "):
            return "query=" + repr(stripped) + "\nresult=pd.read_sql_query(query, con)\nprint(result.to_string(index=False))"
        return "cursor.execute(" + repr(stripped) + ")\ncon.commit()\nprint('OK')"
    return c

def runner_prelude():
    return r"""
import os, sys, json, sqlite3, datetime, string, itertools, types
import numpy as np
import pandas as pd
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
try:
    import seaborn as sns
    if not hasattr(sns, "distplot"):
        def _distplot(x, kde=False, vertical=False, **kwargs):
            return sns.histplot(y=x, kde=kde) if vertical else sns.histplot(x=x, kde=kde)
        sns.distplot=_distplot
except Exception:
    class _SNS:
        def _one(self,*args,**kwargs): return plt.gca()
        distplot=_one; lmplot=_one; regplot=_one; jointplot=_one
        boxplot=_one; barplot=_one; stripplot=_one; pointplot=_one
        def set_palette(self,*args,**kwargs): pass
        def set_style(self,*args,**kwargs): pass
        def axes_style(self,*args,**kwargs): return {}
        class FacetGrid:
            def __init__(self,*args,**kwargs): pass
            def map(self,*args,**kwargs): return self
            def add_legend(self): return self
    sns=_SNS()

_names=types.ModuleType("names")
_first=["Anna","Luca","Julia","Max","Sophie","Noah","Laura","Leon","Mia","Jonas"]
_last=["Meier","Müller","Weber","Schmid","Keller","Rossi","Fischer","Huber"]
import random
_names.get_first_name=lambda gender=None: random.choice(_first)
_names.get_last_name=lambda: random.choice(_last)
_names.get_full_name=lambda gender=None: random.choice(_first)+" "+random.choice(_last)
sys.modules["names"]=_names

transactions=pd.read_csv("data/transactions.csv")
transactions["TransDate"]=pd.to_datetime(transactions["TransDate"], errors="coerce")
transactions["Year"]=transactions["TransDate"].dt.year
myData=transactions.copy()
df=myData.copy()
CustData=pd.read_csv("customers.csv")
if "customer_id" in CustData.columns:
    CustData=pd.DataFrame({
        "Customer":CustData["customer_id"],
        "CustId":CustData["customer_id"],
        "Store":CustData.get("acquisition_channel",pd.Series(["online"]*len(CustData))).astype(str),
        "JoinDate":pd.to_datetime(CustData.get("registration_date"), errors="coerce")
    })
A=pd.DataFrame({"ID":[1,2,3,4],"TransDate":pd.to_datetime(["2025-01-01","2025-01-02","2025-01-03","2025-01-04"]),"ValueA":[10,20,30,40]})
B=pd.DataFrame({"ID":[2,3,4,5],"TransDate":pd.to_datetime(["2025-01-02","2025-01-03","2025-01-04","2025-01-05"]),"ValueB":[200,300,400,500]})
X=A.copy()
Y=B.copy()
con=sqlite3.connect("database.sqlite")
cursor=con.cursor()
DataFrame=pd.DataFrame
"""


def ensure_runtime_data():
    """Erzeugt die gemeinsame Basis einmal; jeder Code-Lauf bekommt daraus eine frische Kopie."""
    marker = GAME_RUNTIME_DIR / "database.sqlite"
    if marker.exists() and (GAME_RUNTIME_DIR / "data" / "transactions.csv").exists():
        return
    GAME_RUNTIME_DIR.mkdir(parents=True, exist_ok=True)
    prepare_base_data(GAME_RUNTIME_DIR)

def run_code(code):
    with tempfile.TemporaryDirectory(prefix="dataflow_runner_") as td:
        work=Path(td)
        ensure_runtime_data()
        shutil.copytree(GAME_RUNTIME_DIR, work, dirs_exist_ok=True)
        adapted=adapt_code(code)
        script=work/"player_code.py"
        script.write_text(runner_prelude()+"\n# --- SPIELERCODE ---\n"+adapted+"\ntry:\n con.commit(); con.close()\nexcept Exception:\n pass\n", encoding="utf-8")
        try:
            p=subprocess.run([sys.executable,str(script)],cwd=str(work),
                             capture_output=True,text=True,timeout=RUN_TIMEOUT)
            return {"ok":p.returncode==0,"stdout":p.stdout,"stderr":p.stderr,
                    "plots":[str(x.relative_to(work)) for x in work.rglob("*.png")],
                    "files":[str(x.relative_to(work)) for x in work.rglob("*.csv") if x.name!="transactions.csv"]}
        except subprocess.TimeoutExpired as e:
            return {"ok":False,"stdout":e.stdout or "","stderr":"Zeitüberschreitung – maximal "+str(RUN_TIMEOUT)+" Sekunden.","plots":[],"files":[]}

def normalize(s):
    return re.sub(r"\s+"," ",str(s).strip().lower())

def parse_number(s):
    s=str(s).strip().replace(",",".")
    if re.fullmatch(r"-?\d+(?:\.\d+)?",s):
        try: return float(s)
        except Exception: return None
    return None

def get_reference(level):
    code=level["pdf_code"]
    if any(x in code for x in ["pip uninstall","conda remove","DROP TABLE"]):
        return None
    result=run_code(code)
    if not result["ok"]:
        return None
    lines=[x.strip() for x in result["stdout"].splitlines() if x.strip()]
    if not lines: return None
    last=lines[-1]
    if len(last)<=120 and not any(x in last for x in ["<class","dtype:","Name:"]):
        return last
    return None

class GameState:
    def __init__(self):
        self.xp=0
        self.completed=[]
        self.current=0
        self.load()
    def load(self):
        try:
            if SAVE_FILE.exists():
                d=json.loads(SAVE_FILE.read_text(encoding="utf-8"))
                self.xp=int(d.get("xp",0))
                self.completed=list(d.get("completed",[]))
                self.current=int(d.get("current",0))
        except Exception:
            pass
    def save(self):
        SAVE_FILE.parent.mkdir(parents=True,exist_ok=True)
        SAVE_FILE.write_text(json.dumps({"xp":self.xp,"completed":self.completed,"current":self.current},ensure_ascii=False,indent=2),encoding="utf-8")
    def complete(self,i):
        if i not in self.completed:
            self.completed.append(i)
            self.xp+=100
            self.save()
            return True
        return False

class DataFlowGame(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title(APP_TITLE)
        self.geometry("1500x900")
        self.minsize(1100,720)
        self.gs=GameState()
        self.current=max(0,min(self.gs.current,len(LEVELS)-1))
        self.last_run=None
        self.ref_cache={}
        self._style()
        self._ui()
        self.load_level(self.current)
    def _style(self):
        s=ttk.Style(self)
        try: s.theme_use("clam")
        except Exception: pass
        s.configure("Title.TLabel",font=("Arial",22,"bold"))
        s.configure("Level.TLabel",font=("Arial",15,"bold"))
        s.configure("Action.TButton",font=("Arial",11,"bold"),padding=8)
    def _ui(self):
        header=ttk.Frame(self,padding=12); header.pack(fill="x")
        ttk.Label(header,text=APP_TITLE,style="Title.TLabel").pack(side="left")
        self.xp_label=ttk.Label(header,text="XP: 0",style="Level.TLabel"); self.xp_label.pack(side="right")
        self.progress_label=ttk.Label(header,text="",style="Level.TLabel"); self.progress_label.pack(side="right",padx=20)
        pane=ttk.Panedwindow(self,orient="horizontal"); pane.pack(fill="both",expand=True,padx=12,pady=(0,12))
        left=ttk.Frame(pane,padding=8); pane.add(left,weight=1)
        ttk.Label(left,text="LEVELS",style="Level.TLabel").pack(anchor="w",pady=(0,8))
        self.level_list=tk.Listbox(left,width=38,font=("Consolas",9),activestyle="dotbox"); self.level_list.pack(fill="both",expand=True)
        self.level_list.bind("<Double-Button-1>",self._select_level)
        center=ttk.Frame(pane,padding=8); pane.add(center,weight=5)
        self.level_title=ttk.Label(center,text="",style="Level.TLabel"); self.level_title.pack(anchor="w")
        self.source_label=ttk.Label(center,text=""); self.source_label.pack(anchor="w",pady=(0,6))
        lf=ttk.LabelFrame(center,text="AUFGABE",padding=8); lf.pack(fill="x",pady=(0,8))
        self.task=tk.Text(lf,height=7,wrap="word",font=("Arial",11)); self.task.pack(fill="x"); self.task.configure(state="disabled")
        ef=ttk.LabelFrame(center,text="PYTHON-EDITOR – freie Lösung",padding=8); ef.pack(fill="both",expand=True)
        self.editor=tk.Text(ef,wrap="none",undo=True,font=("Consolas",11)); self.editor.pack(fill="both",expand=True)
        br=ttk.Frame(center); br.pack(fill="x",pady=8)
        ttk.Button(br,text="▶ CODE AUSFÜHREN",style="Action.TButton",command=self.run_player).pack(side="left")
        ttk.Button(br,text="PDF-CODE",command=self.show_pdf).pack(side="left",padx=6)
        ttk.Button(br,text="HINWEIS",command=self.show_hint).pack(side="left")
        ttk.Button(br,text="◀ VORHERIGES",command=lambda:self.load_level(self.current-1)).pack(side="right")
        ttk.Button(br,text="NÄCHSTES ▶",command=lambda:self.load_level(self.current+1)).pack(side="right",padx=6)
        right=ttk.Frame(pane,padding=8); pane.add(right,weight=3)
        of=ttk.LabelFrame(right,text="PYTHON-OUTPUT",padding=8); of.pack(fill="both",expand=True)
        self.output=tk.Text(of,wrap="word",font=("Consolas",10)); self.output.pack(fill="both",expand=True)
        af=ttk.LabelFrame(right,text="DEINE ANTWORT",padding=8); af.pack(fill="x",pady=(8,0))
        ttk.Label(af,text="Ergebnis / Antwort separat eingeben:").pack(anchor="w")
        self.answer=ttk.Entry(af,font=("Arial",12)); self.answer.pack(fill="x",pady=5)
        ttk.Button(af,text="✅ ANTWORT PRÜFEN",style="Action.TButton",command=self.check_answer).pack(fill="x")
        ttk.Button(af,text="REFERENZ / LÖSUNG",command=self.show_reference).pack(fill="x",pady=(5,0))
        self.status=ttk.Label(self,text="Bereit.",relief="sunken",anchor="w",padding=5); self.status.pack(fill="x",side="bottom")
    def refresh_level_list(self):
        self.level_list.delete(0,tk.END)
        for i,lv in enumerate(LEVELS):
            mark="✅" if i in self.gs.completed else "⬜"
            self.level_list.insert(tk.END,f"{mark} {i+1:03d}  {lv['title'][:46]}")
        if LEVELS:
            self.level_list.selection_clear(0,tk.END); self.level_list.selection_set(self.current); self.level_list.see(self.current)
        self.xp_label.config(text=f"XP: {self.gs.xp}")
        self.progress_label.config(text=f"{len(self.gs.completed)}/{len(LEVELS)} Levels")
    def load_level(self,index):
        if not LEVELS: return
        self.current=max(0,min(index,len(LEVELS)-1)); self.gs.current=self.current; self.gs.save()
        lv=LEVELS[self.current]
        self.level_title.config(text=f"Level {self.current+1:03d} – {lv['title']}")
        self.source_label.config(text=f"Quelle: Codes_python_data_analytics.pdf · Seite {lv.get('page','?')}")
        self.task.configure(state="normal"); self.task.delete("1.0",tk.END); self.task.insert("1.0",lv["task"]); self.task.configure(state="disabled")
        self.editor.delete("1.0",tk.END)
        self.editor.insert("1.0","# Schreibe hier deine eigene Lösung.\n# Du darfst zuerst frei untersuchen: df.head(), df.info(), df.dtypes, df.columns ...\n# PDF-CODE zeigt das Originalbeispiel; es ist nicht deine einzige mögliche Lösung.\n\n")
        self.output.delete("1.0",tk.END); self.output.insert("1.0","Noch kein Code ausgeführt.\n")
        self.answer.delete(0,tk.END); self.last_run=None; self.refresh_level_list()
        self.status.config(text="Level geladen – freie Lösungswege sind erlaubt.")
    def _select_level(self,_=None):
        sel=self.level_list.curselection()
        if sel: self.load_level(sel[0])
    def run_player(self):
        code=self.editor.get("1.0",tk.END)
        if not code.strip(): return
        self.status.config(text="Code wird ausgeführt ..."); self.update_idletasks()
        self.last_run=run_code(code)
        self.output.delete("1.0",tk.END)
        if self.last_run["ok"]:
            self.output.insert("1.0",self.last_run["stdout"] or "(keine Ausgabe)")
            self.output.insert(tk.END,"\n\n✅ Code erfolgreich ausgeführt.")
            if self.last_run["plots"]: self.output.insert(tk.END,"\n📊 Plot-Artefakt(e): "+", ".join(self.last_run["plots"]))
            if self.last_run["files"]: self.output.insert(tk.END,"\n📁 Datei(en): "+", ".join(self.last_run["files"]))
            self.status.config(text="Code erfolgreich. Jetzt Antwort separat prüfen.")
        else:
            self.output.insert("1.0","❌ FEHLER\n\n"+(self.last_run.get("stdout") or "")+"\n"+(self.last_run.get("stderr") or ""))
            self.status.config(text="Code fehlgeschlagen – Fehler analysieren und erneut versuchen.")
    def show_pdf(self):
        lv=LEVELS[self.current]
        w=tk.Toplevel(self); w.title("PDF-Code / Level"); w.geometry("1000x700")
        ttk.Label(w,text=f"Original-Code aus dem PDF · Seite {lv.get('page','?')}",style="Level.TLabel").pack(anchor="w",padx=12,pady=10)
        txt=tk.Text(w,wrap="none",font=("Consolas",10)); txt.pack(fill="both",expand=True,padx=12,pady=(0,12))
        txt.insert("1.0",lv["pdf_code"]); txt.configure(state="disabled")
    def show_hint(self):
        code=LEVELS[self.current]["pdf_code"]
        if "groupby" in code: h="Denke an Gruppieren und danach an eine Aggregation."
        elif "merge" in code or "JOIN" in code: h="Achte auf gemeinsame Schlüssel/IDs und den Join-Typ."
        elif "plt." in code or "sns." in code: h="Erzeuge die Grafik aus den Daten. Ein Plot darf beliebig aufgebaut werden."
        elif "SELECT " in code or "sqlite3" in code: h="Die Datenbank läuft lokal über SQLite. Nutze sqlite3, cursor.execute() oder pd.read_sql_query()."
        elif "def " in code: h="Definiere die Funktion, berechne das Ergebnis und gib es mit return zurück."
        elif "np.random" in code: h="Achte auf size, replace, loc, scale und seed."
        else: h="Untersuche zuerst die Daten mit df.head(), df.info(), df.dtypes oder df.columns."
        messagebox.showinfo("Hinweis",h)
    def expected(self):
        if self.current not in self.ref_cache: self.ref_cache[self.current]=get_reference(LEVELS[self.current])
        return self.ref_cache[self.current]
    def check_answer(self):
        ans=self.answer.get().strip()
        if not ans:
            messagebox.showwarning("Antwort fehlt","Bitte trage zuerst deine Antwort ein."); return
        if not self.last_run or not self.last_run["ok"]:
            messagebox.showwarning("Code zuerst ausführen","Führe deinen Code zuerst erfolgreich aus."); return
        exp=self.expected()
        code=LEVELS[self.current]["pdf_code"]
        action=(("plt." in code or "sns." in code) or ("to_csv" in code or "savefig" in code)
                or code.strip().startswith("#") or code.strip().startswith("help("))
        if exp is not None:
            a=parse_number(ans); b=parse_number(exp)
            correct=(abs(a-b)<1e-9) if a is not None and b is not None else (normalize(ans)==normalize(exp))
        elif action:
            correct=True
        else:
            correct=True
        if correct:
            new=self.gs.complete(self.current); self.refresh_level_list()
            msg="✅ LEVEL GESCHAFFT\n\n"
            msg += (f"Referenzantwort: {exp}\n" if exp is not None else "Erfolgreiche Ausführung / offene Analyse bestätigt.\n")
            if new: msg += "\n+100 XP"
            messagebox.showinfo("Erfolg",msg); self.status.config(text="Level gelöst.")
        else:
            messagebox.showerror("Noch nicht richtig","Die Antwort stimmt noch nicht mit der Referenz überein.")
    def show_reference(self):
        lv=LEVELS[self.current]; exp=self.expected()
        w=tk.Toplevel(self); w.title("Referenz / Lösung"); w.geometry("1000x750")
        txt=tk.Text(w,wrap="word",font=("Consolas",10)); txt.pack(fill="both",expand=True,padx=12,pady=12)
        txt.insert("1.0",f"LEVEL {self.current+1:03d}\n{lv['title']}\n\nAufgabe:\n{lv['task']}\n\n")
        if exp is not None: txt.insert(tk.END,"Automatisch ermittelte Referenzantwort:\n"+exp+"\n\n")
        else: txt.insert(tk.END,"Keine kurze eindeutige Referenzantwort automatisch erkannt.\nFür diesen Level ist die erfolgreiche Ausführung / eigene Analyse wichtig.\n\n")
        txt.insert(tk.END,"Original-Code aus dem PDF:\n"+lv["pdf_code"]); txt.configure(state="disabled")

def main():
    SAVE_FILE.parent.mkdir(parents=True,exist_ok=True)
    try:
        ensure_runtime_data()
    except Exception:
        pass
    app=DataFlowGame()
    app.mainloop()

if __name__=="__main__":
    main()
