# ---------------------------------------------------------------------------
# STORY-DRIVEN MISSION DESIGN
# ---------------------------------------------------------------------------
# Die PDF-Beispiele bleiben das technische Lernziel, werden dem Spieler aber
# nicht mehr als Aufgabe gezeigt. Jede Mission beschreibt eine konkrete
# Situation, in der das jeweilige Konzept gebraucht wird. Das PDF-Beispiel
# ist nur noch eine optionale Referenz nach einem eigenen Versuch.

STORY_CONTEXTS = [
    "Im Data-Operations-Team", "Im Vertriebsreport", "Im Marketing-Dashboard",
    "Beim Monatsabschluss", "Bei der Datenprüfung", "Im Kundenservice",
    "Im Lagerreport", "Bei der Kampagnenanalyse", "Im Management-Report",
    "Beim Import der Tagesdaten", "Im Qualitätssicherungsprozess", "Im Data Lab",
]


def _mission_answer(level, answer, mode="text", keywords=None, title=None, task=None, hint=None):
    if title:
        level["title"] = title
    if task:
        level["task"] = task
    if hint:
        level["hint"] = hint
    level["answer"] = str(answer)
    level["answer_mode"] = mode
    level["keywords"] = keywords or []
    # Der Originalcode bleibt technisch hinterlegt, wird aber nicht mehr als
    # eigentliche Aufgabenstellung verwendet.
    return level


def build_story_mission(level, i):
    c = level.get("pdf_code", "")
    original_title = level.get("title", "")
    p = level.get("page", "?")
    ctx = STORY_CONTEXTS[i % len(STORY_CONTEXTS)]

    # 1–13: Grundlagen / Import / Datenüberblick
    if c.startswith('print("Text")'):
        return _mission_answer(level, "Datenimport gestartet", "text", ["print"],
            "Die Pipeline soll sichtbar reagieren",
            f"{ctx}: Eine neue Datenpipeline startet. Zeige in der Konsole exakt die Meldung `Datenimport gestartet`, damit das Team sofort erkennt, dass der Prozess angelaufen ist.",
            "Du brauchst hier noch kein pandas. Überlege, wie Python Text auf der Konsole ausgeben kann.")
    if c.startswith("variableName ="):
        return _mission_answer(level, "42", "number", ["=", "variable"],
            "Eine Kennzahl speichern",
            "Die Qualitätsabteilung legt einen Prüfwert von 42 fest. Speichere diesen Wert in einer Variable und gib ihn anschließend aus. Die Variable soll `check_value` heißen.",
            "Eine Variable entsteht durch eine Zuweisung mit `=`.")
    if "pd.read_csv" in c:
        return _mission_answer(level, "650", "number", ["read_csv"],
            "Ein CSV-Export kommt an",
            f"{ctx}: Die Verkaufsabteilung liefert den täglichen CSV-Export. Lade `data/transactions.csv` in einen DataFrame namens `myData` und finde heraus, wie viele Transaktionen enthalten sind. Untersuche die Datei zuerst nach Bedarf.",
            "Zum Einlesen einer CSV-Datei brauchst du pandas und einen Dateipfad.")
    if "to_csv" in c:
        return _mission_answer(level, "export.csv", "text", ["to_csv"],
            "Einen Report exportieren",
            "Der Teamleiter möchte die aktuell geladene Tabelle als CSV archivieren. Speichere deinen DataFrame als `export.csv` ab und kontrolliere anschließend, ob die Datei erzeugt wurde.",
            "Suche nach einer DataFrame-Methode, die einen CSV-Export übernimmt.")
    if c.startswith("del DataFrame"):
        return _mission_answer(level, "DataFrame gelöscht", "text", ["del"],
            "Arbeitsplatz aufräumen",
            "Du hast einen großen temporären DataFrame namens `temp_data` erzeugt. Nach dem Report wird er nicht mehr benötigt. Entferne ihn aus dem Workspace.",
            "Mit welchem Python-Befehl löscht du eine Variable aus dem Workspace?")
    if c.startswith("myData.dtypes"):
        return _mission_answer(level, "Prüfung der Datentypen", "text", ["dtypes"],
            "Warum rechnet Python plötzlich falsch?",
            f"{ctx}: Ein Kollege vermutet, dass eine Spalte als Text importiert wurde. Lade die Transaktionen und untersuche die Datentypen aller Spalten. Gib im Antwortfeld `Prüfung der Datentypen` ein, sobald du die Kontrolle durchgeführt hast.",
            "Gesucht ist eine Übersicht der Datentypen, nicht nur ein einzelner Wert.")
    if c.startswith("myData.head"):
        return _mission_answer(level, "Erste 3 Zeilen", "text", ["head"],
            "Der erste Blick auf Rohdaten",
            "Bevor du den Report programmierst, möchtest du einen schnellen Blick auf die ersten drei Transaktionen werfen. Zeige genau diese ersten drei Zeilen an.",
            "Eine pandas-Methode nimmt die gewünschte Anzahl von Zeilen als Argument.")
    if c.startswith("myData.tail"):
        return _mission_answer(level, "Letzte 3 Zeilen", "text", ["tail"],
            "Ist der Export vollständig?",
            "Kontrolliere die letzten drei Transaktionen des Imports. So kannst du prüfen, ob die Datei am Ende sauber abgeschlossen wurde.",
            "Es gibt eine Gegenstück-Methode zu `head()` für das Tabellenende.")
    if c.startswith("myData.describe"):
        return _mission_answer(level, "Statistische Übersicht", "text", ["describe"],
            "Schneller Gesundheitscheck",
            "Die Finance-Abteilung möchte einen schnellen Überblick über die numerischen Felder: Mittelwert, Streuung, Minimum und Maximum. Erzeuge eine statistische Zusammenfassung des DataFrames.",
            "Pandas kann numerische Spalten mit einer einzigen Methode zusammenfassen.")
    if "pd.Series" in c and 'dtype="category"' in c:
        return _mission_answer(level, "category", "text", ["Series", "category"],
            "Eine Liste wird zu Kategorien",
            "Du baust eine kleine Statusliste mit den Werten `a`, `b` und `c`. Erzeuge daraus eine pandas Series mit dem Datentyp `category` und prüfe anschließend den Typ.",
            "Achte darauf, dass hier nicht nur eine normale Liste entsteht, sondern eine kategoriale Series.")
    if "datetime.datetime" in c:
        return _mission_answer(level, "2009-10-05", "text", ["datetime"],
            "Ein Stichtag wird festgelegt",
            "Für einen historischen Audit muss der Stichtag 5. Oktober 2009 als echtes Python-Datum gespeichert werden. Erzeuge das passende Datumsobjekt.",
            "Das Ziel ist ein Datumobjekt, kein String.")
    if "pd.to_datetime" in c:
        return _mission_answer(level, "Datumsformat konvertiert", "text", ["to_datetime"],
            "Uneinheitliche Datumswerte",
            "Ein Alt-Export enthält Datumswerte im Format `TT.MM.JJJJ`. Konvertiere die betroffene Spalte in ein echtes Datum und achte auf die richtige Reihenfolge von Tag und Monat.",
            "Nutze die pandas-Konvertierung für Datumswerte und gib das Format explizit an.")
    if c.startswith("myData.loc[row_index"):
        return _mission_answer(level, "1. Zeile + Customer", "text", ["loc"],
            "Eine einzelne Zelle prüfen",
            "Ein Auditor möchte die Customer-ID der ersten Transaktion direkt aus der Tabelle sehen. Greife gezielt auf die erste Zeile und die Spalte `Customer` zu.",
            "`loc` arbeitet mit Index und Spaltenlabel.")

    # 14–25: Plotting
    if "plt.hist" in c:
        return _mission_answer(level, "Histogramm", "text", ["plt.hist"],
            "Wie verteilt sich der Bestellwert?",
            "Das Management möchte sehen, wie sich die Einkaufsbeträge verteilen. Erstelle ein Histogramm der Spalte `PurchAmount` mit 10 Klassen.",
            "Ein Histogramm zeigt die Verteilung einer einzelnen numerischen Variable.")
    if "plt.scatter" in c:
        return _mission_answer(level, "Scatterplot", "text", ["scatter"],
            "Hängen Einkauf und Kosten zusammen?",
            "Untersuche, ob höhere Einkaufsbeträge mit höheren Kosten zusammen auftreten. Erstelle dazu einen Scatterplot mit `PurchAmount` auf der x-Achse und `Cost` auf der y-Achse.",
            "Gesucht ist ein Punktdiagramm für zwei Variablen.")
    if "plt.plot" in c:
        color = "grün" if '"go"' in c or 'color="green"' in c else ""
        return _mission_answer(level, "Liniendiagramm", "text", ["plt.plot"],
            "Eine einfache Zeitreihe sichtbar machen",
            f"{ctx}: Zeichne eine einfache Punkt-/Liniengrafik aus zwei vorbereiteten Zahlenreihen. Die Darstellung soll{' grüne Marker' if color else ''} verwenden.",
            "`plot()` kann Datenreihen und Marker darstellen. Du darfst die Darstellung selbst aufbauen.")
    if c.startswith("plt.show"):
        return _mission_answer(level, "Diagramm angezeigt", "text", ["plt.show"],
            "Der Report soll wirklich erscheinen",
            "Du hast einen Plot vorbereitet, aber im Team sieht niemand etwas. Sorge dafür, dass die aktuelle Matplotlib-Grafik tatsächlich angezeigt bzw. abgeschlossen wird.",
            "Es gibt einen klassischen Befehl zum Anzeigen vorbereiteter Matplotlib-Grafiken.")
    if c.startswith("plt.xlabel"):
        return _mission_answer(level, "Purchase Amount", "text", ["xlabel"],
            "Die x-Achse beschriften",
            "Im Management-Chart muss die x-Achse klar sagen, dass dort der Einkaufsbetrag steht. Beschrifte die x-Achse mit `Purchase Amount` und formatiere die Beschriftung sichtbar hervorgehoben.",
            "Überlege, welche Matplotlib-Funktion die x-Achsenbeschriftung setzt.")
    if c.startswith("plt.ylabel"):
        return _mission_answer(level, "Cost", "text", ["ylabel"],
            "Die y-Achse beschriften",
            "Beschrifte die y-Achse des Kosten-Charts mit `Cost` und formatiere die Beschriftung passend zum Bericht.",
            "Die Funktion für die y-Achse ähnelt der für die x-Achse.")
    if c.startswith("plt.title"):
        return _mission_answer(level, "Costs by Purchase Amount", "text", ["title"],
            "Ein Chart braucht einen verständlichen Titel",
            "Der Bericht soll sofort erkennen lassen, was der Plot zeigt. Setze den Titel `Costs by Purchase Amount` und formatiere ihn deutlich.",
            "Der Titel wird direkt an die aktuelle Matplotlib-Achse gesetzt.")
    if c.startswith("plt.xlim") or c.startswith("plt.ylim"):
        return _mission_answer(level, "Achsenbereich begrenzt", "text", ["xlim", "ylim"],
            "Ein Ausreißer sprengt die Grafik",
            "Für einen Management-Chart sollen die Achsen bewusst auf einen festen Wertebereich begrenzt werden. Setze mindestens eine x- und eine y-Grenze sinnvoll für einen 0–500-Report.",
            "Matplotlib bietet dafür jeweils eine eigene Grenzfunktion.")
    if c.startswith("plt.text"):
        return _mission_answer(level, "Hinweis im Plot", "text", ["plt.text"],
            "Eine Warnung direkt am Datenpunkt",
            "Markiere einen auffälligen Bereich im Chart mit dem Text `Achtung: hoher Wert`. Platziere die Meldung direkt an einer geeigneten Koordinate.",
            "Text kann direkt innerhalb der Plot-Fläche platziert werden.")
    if c.startswith("plt.subplot"):
        return _mission_answer(level, "2 Teilgrafiken", "text", ["subplot"],
            "Zwei Charts auf einem Bericht",
