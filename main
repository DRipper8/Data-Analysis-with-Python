            "Ein KPI-Paket für das Management",
            "Schreibe eine Funktion `KPIs`, die für einen übergebenen Datensatz gleichzeitig Profit und ROI berechnet und beide Werte gemeinsam zurückgibt.",
            "Eine Funktion darf auch mehrere Ergebnisse als Liste zurückgeben.")
    if 'np.sqrt(np.var' in c and 'np.std' in c:
        return _mission_answer(level, "Standardabweichung", "text", ["np.std"],
            "Streuung einer Zahlenreihe",
            "Berechne die Standardabweichung einer kleinen Zahlenreihe einmal direkt mit NumPy und überprüfe, dass eine direkte Funktion verfügbar ist.",
            "`np.std()` ist die direkte Variante.")
    if c.startswith('range(2, 13)'):
        return _mission_answer(level, "2 bis 12", "text", ["range"],
            "Eine Folge für einen Testlauf erzeugen",
            "Erzeuge die Ganzzahlfolge für die Monats-IDs 2 bis 12. Die obere Grenze soll nicht enthalten sein.",
            "Bei `range(start, stop)` ist `stop` ausgeschlossen.")
    if c.startswith('np.arange(start=1, stop=12, step=3)'):
        return _mission_answer(level, "1, 4, 7, 10", "text", ["arange"],
            "Regelmäßige Messpunkte",
            "Erzeuge mit NumPy eine Zahlenfolge von 1 bis kleiner als 12 mit einer Schrittweite von 3. Teste zusätzlich, dass `arange` auch Dezimalwerte verarbeiten kann.",
            "`np.arange()` ist praktisch, wenn du eine frei wählbare Schrittweite brauchst.")
    if 'ascii_lowercase' in c:
        return _mission_answer(level, "a, b, c, d, e", "text", ["ascii_lowercase"],
            "Buchstaben für Testschlüssel erzeugen",
            "Erzeuge die ersten fünf Kleinbuchstaben automatisch. Du sollst sie nicht einzeln hinschreiben.",
            "Das `string`-Modul stellt die Buchstabenfolgen bereits bereit.")
    if c.startswith('pd.date_range'):
        return _mission_answer(level, "3 Monatsanfänge", "text", ["date_range"],
            "Ein Monatskalender für ein Testscript",
            "Erzeuge die Monatsanfänge von Januar bis März 2011 als Datumsreihe.",
            "Nutze `freq=""MS""` für Monatsanfänge.")
    if c.startswith('np.tile'):
        return _mission_answer(level, "36 Werte", "number", ["tile"],
            "Ein Jahresmuster drei Mal wiederholen",
            "Du brauchst die Monate 1 bis 12 dreimal hintereinander. Erzeuge diese Sequenz automatisch.",
            "`tile()` wiederholt die komplette Sequenz.")
    if c.startswith('np.repeat'):
        return _mission_answer(level, "36 Werte", "number", ["repeat"],
            "Jeder Monat bekommt drei Slots",
            "Erzeuge die Monate 1 bis 12 so, dass jeder Monat drei Mal hintereinander vorkommt.",
            "`repeat()` wiederholt jedes Element statt die gesamte Sequenz.")
    if c.startswith('list(itertools.product'):
        return _mission_answer(level, "6 Kombinationen", "number", ["itertools.product"],
            "Alle möglichen Testkombinationen",
            "Erzeuge alle Kombinationen aus den IDs 165, 166, 167 und den Statuswerten 1 und 2. Wie viele Kombinationen entstehen?",
            "Das kartesische Produkt kombiniert jedes Element der ersten mit jedem der zweiten Liste.")
    if c.startswith('CustData.drop_duplicates'):
        return _mission_answer(level, "Duplikate entfernt", "text", ["drop_duplicates"],
            "Doppelte Stammdaten bereinigen",
            "Vor dem Merge sollen doppelte Kundenzeilen aus `CustData` entfernt werden. Bereite einen deduplizierten DataFrame vor und prüfe die Anzahl der eindeutigen Zeilen.",
            "`drop_duplicates()` entfernt doppelte Zeilen.")
    if c.startswith('import names'):
        return _mission_answer(level, "Name erzeugt", "text", ["names", "get_"],
            "Testdaten mit realistisch wirkenden Namen",
            "Ein Demo-System braucht einen zufälligen Vor-, Nach- und vollständigen Namen für Testdaten. Erzeuge mindestens einen davon mit einer passenden Namensfunktion.",
            "Das Skript zeigt dafür das Paket `names`; unser Spiel stellt dafür eine lokale Ersatzfunktion bereit.")
    if c.startswith('ids ='):
        return _mission_answer(level, "0001, 0010", "text", ["zfill"],
            "Kundencodes standardisieren",
            "Die IDs `[1, 10]` sollen als vierstellige Strings ausgegeben werden. Ergänze führende Nullen.",
            "`zfill(4)` erweitert einen String auf vier Stellen.")
    if c.startswith("friends = ['Nicholas'"):
        return _mission_answer(level, "True, False, False", "text", ["in", "for"],
            "Bestimmten Namen finden",
            "Prüfe für die Liste `['Nicholas', 'Thomas', 'Kayla']`, ob jeder Eintrag die Zeichenkette `Nicholas` enthält.",
            "Eine List Comprehension kann für jeden Eintrag eine True/False-Prüfung erzeugen.")
    if c.startswith('firstname.split'):
        return _mission_answer(level, "Vorname + Rest", "text", ["split"],
            "Einen vollständigen Namen zerlegen",
            "Ein vollständiger Name soll beim ersten Leerzeichen in maximal zwei Teile zerlegt werden. Verwende einen passenden String-Ansatz.",
            "`split(separator, maxsplit)` kann die maximale Anzahl der Trennungen begrenzen.")
    if c.startswith('list(map(hash'):
        return _mission_answer(level, "Hash-Liste", "text", ["hash", "map"],
            "IDs für einen Testdatensatz pseudonymisieren",
            "Erzeuge für alle Kunden-IDs eine Liste numerischer Hashwerte, sodass die ursprünglichen IDs nicht direkt ausgegeben werden.",
            "Der im PDF gezeigte Ansatz nutzt `hash` als Funktion innerhalb von `map`.")
    if 'Store_Cust' in c and 'astype(str)' in c:
        return _mission_answer(level, "Store_Cust", "text", ["astype", "Store_Cust"],
            "Eine zusammengesetzte Schlüsselspalte",
            "Erzeuge eine neue Spalte `Store_Cust`, die Store und CustId mit einem Unterstrich verbindet. Achte darauf, dass beide Bestandteile Strings werden.",
            "Mit `.astype(str)` lassen sich Spalten vor dem Zusammenfügen in Strings umwandeln.")
    if c.startswith('np.random.choice'):
        return _mission_answer(level, "5 Werte", "number", ["random.choice"],
            "Eine Stichprobe aus diskreten Werten",
            "Für einen Testlauf werden zufällig fünf Werte aus 0 bis 9 gezogen. Ziehe sie ohne Zurücklegen.",
            "`replace=False` bedeutet: Ein Wert darf in der Stichprobe nicht mehrfach vorkommen.")
    if c.startswith('np.random.normal'):
        return _mission_answer(level, "500", "number", ["random.normal"],
            "Simulierte Messwerte",
            "Ein Sensor-Simulator soll 500 Messwerte mit Mittelwert 5 und Standardabweichung 1 erzeugen. Erzeuge die Stichprobe.",
            "Bei einer Normalverteilung stehen `loc` und `scale` für Mittelwert und Standardabweichung.")
    if c.startswith('np.random.seed'):
        return _mission_answer(level, "wiederholbar", "text", ["random.seed", "normal"],
            "Der Zufall muss reproduzierbar werden",
            "Für einen Unit-Test sollen fünf Zufallswerte nach jedem Start identisch sein. Setze einen festen Seed und generiere anschließend die fünf Werte.",
            "Ein fester Seed sorgt dafür, dass dieselbe Zufallssequenz reproduzierbar wird.")

    if 'groupby("Customer").agg(new_col=("PurchAmount", "sum"))' in c:
        return _mission_answer(level, "AggPurch", "text", ["groupby", "agg", "sum"],
            "Kundensummen als neuer Report",
            "Der CRM-Export soll je Kunde genau eine Zeile enthalten und eine neue Spalte `new_col` mit der gesamten Kaufsumme ausweisen.",
            "Gruppiere nach Kunde, aggregiere `PurchAmount` mit `sum()` und setze den Index zurück.")
    if 'groupby("Customer").agg(AggPurch=("PurchAmount", "sum")' in c and 'AggQuant' not in c and 'MaxPurch' not in c and 'lambda' not in c and "Chaining" not in original_title:
        return _mission_answer(level, "AggPurch", "text", ["groupby", "agg", "sum"],
            "Kundensummen mit einem sprechenden Namen",
            "Erstelle den CRM-Report erneut, aber nenne die Summenspalte ausdrücklich `AggPurch`.",
            "Benannte Aggregationen erlauben einen eigenen Namen für das Ergebnis.")
    if 'groupby("Customer").agg(AggPurch=("PurchAmount", "sum"))' in c and 'lambda' in c:
        return _mission_answer(level, "Kunden über 100", "text", ["groupby", "lambda"],
            "Ein kompakter Filter nach Aggregation",
            "Ermittle zuerst die Kaufsumme je Kunde und filtere danach direkt in derselben Kette auf Kunden mit mehr als 100 Umsatz.",
            "Das Lernziel ist Method Chaining plus Lambda-Filter.")
    if 'for city in cities:' in c and "break" in original_title:
        return _mission_answer(level, "London", "text", ["for", "break"],
            "Stoppe beim gesuchten Eintrag",
            "Gehe die Liste der Städte durch und brich den Durchlauf sofort ab, sobald `London` erreicht wurde.",
            "`break` verlässt die Schleife vollständig.")
    if 'for city in cities:' in c and "continue" in original_title:
        return _mission_answer(level, "London übersprungen", "text", ["for", "continue"],
            "Einen Eintrag überspringen",
            "Verarbeite alle Städte außer `London`. Der restliche Durchlauf soll weitergehen.",
            "`continue` überspringt nur den aktuellen Durchlauf.")
    if 'np.array([1-3])' in c:
        return _mission_answer(level, "NumPy-Array", "text", ["np.array"],
            "Vektorisierte Berechnung vorbereiten",
            "Erzeuge ein NumPy-Array aus einer kleinen Zahlenfolge und führe anschließend eine arithmetische Operation auf dem gesamten Array aus.",
            "NumPy-Arrays sind die Grundlage für vektorisierte Rechnungen.")
    if c.strip() == 'myData.groupby("Customer").agg(AggPurch=("PurchAmount",' and "Chaining" not in original_title:
        return _mission_answer(level, "AggPurch", "text", ["groupby", "agg"],
            "Kundensumme mit sprechendem Ergebnisnamen",
            "Erstelle für jeden Customer eine aggregierte Tabelle mit einer Spalte `AggPurch`, die den gesamten Einkaufsbetrag je Kunde enthält.",
            "Gruppiere nach `Customer` und benenne die Summe der `PurchAmount`-Spalte als `AggPurch`.")
    if c.strip() == 'myData.groupby("Customer").agg(AggPurch=("PurchAmount",' and "Chaining" in original_title:
        return _mission_answer(level, "Kunden über 100", "text", ["groupby", "agg", "loc"],
            "Aggregation und Filter verbinden",
            "Erstelle zuerst die Kaufsumme je Kunde und filtere anschließend das Aggregationsergebnis auf Kunden mit einem `AggPurch` über 100.",
            "Das Lernziel ist die Reihenfolge: aggregieren, zurück in einen DataFrame, danach filtern.")
    # Fallback – auch unbekannte Beispiele bekommen eine echte Situation.
    return _mission_answer(level, "Aufgabe ausgeführt", "text", [],
        f"Praxisauftrag {i+1:03d}",
        f"{ctx}: Setze das in diesem Abschnitt des Kurses gelernte Konzept in einer kleinen praktischen Analyse ein. Untersuche die Daten zunächst selbst und führe danach eine passende Operation durch. Verwende anschließend das Antwortfeld, um dein Ergebnis zu dokumentieren.",
        "Nutze die Daten, experimentiere im Editor und arbeite dich Schritt für Schritt vor.")


