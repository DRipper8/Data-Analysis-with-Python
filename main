assert all(not l.get("title", "").startswith("Code-Beispiel:") for l in LEVELS), "Ein Leveltitel verrät noch direkt den PDF-Code."

def find_workbook():
    candidates = [
        Path("data") / "orders.xlsx",
        Path("data") / "uebungsdatensatz_data_wrangling_online_shop.xlsx",
        Path("uebungsdatensatz_data_wrangling_online_shop.xlsx"),
    ]
    return next((p for p in candidates if p.exists()), None)

def _synthetic_shop_data():
    import pandas as pd
    import numpy as np
    rng = np.random.default_rng(42)
    n_customers, n_orders = 120, 650
    ids = np.arange(1001, 1001+n_customers)
    customers = pd.DataFrame({
        "customer_id": ids,
        "name": [f"Customer {i}" for i in ids],
        "gender": rng.choice(["female","male"], n_customers),
        "age": rng.integers(18,70,n_customers),
        "city": rng.choice(["Zurich","Bern","Basel","Lucerne","Geneva"], n_customers),
        "postal_code": rng.integers(1000,9999,n_customers),
        "segment": rng.choice(["Standard","Premium","VIP"], n_customers),
        "acquisition_channel": rng.choice(["organic","social","email","paid"], n_customers),
        "registration_date": pd.date_range("2023-01-01", periods=n_customers, freq="5D"),
    })
    pids=np.arange(2001,2036)
    products=pd.DataFrame({
        "product_id":pids,
        "product_name":[f"Product {i}" for i in pids],
        "category":rng.choice(["Electronics","Home","Sport","Beauty","Books"],35),
        "brand":rng.choice(["Brand A","Brand B","Brand C"],35),
        "price_chf":np.round(rng.uniform(10,450,35),2),
        "cost_chf":np.round(rng.uniform(5,250,35),2),
        "stock":rng.integers(0,100,35)
    })
    dates=pd.to_datetime("2025-01-01")+pd.to_timedelta(rng.integers(0,365,n_orders),unit="D")
    qty=rng.integers(1,6,n_orders)
    price=rng.choice(products["price_chf"],n_orders)
    gross=np.round(qty*price,2)
    discount=np.round(rng.choice([0,0,0,5,10,15,20],n_orders),2)
    shipping=rng.choice([0,4.9,6.9],n_orders)
    net=np.round(gross-discount+shipping,2)
    orders=pd.DataFrame({
        "order_id":np.arange(500001,500001+n_orders),
        "order_date":dates,
        "customer_id":rng.choice(ids,n_orders),
        "product_id":rng.choice(pids,n_orders),
        "quantity":qty,
        "gross_amount_chf":gross,
        "promo_code":rng.choice(["","SAVE10","WELCOME","SPRING"],n_orders),
        "discount_chf":discount,
        "shipping_chf":shipping,
        "net_amount_chf":net,
        "payment_method":rng.choice(["card","paypal","twint"],n_orders),
        "status":rng.choice(["completed","completed","completed","cancelled"],n_orders),
        "shipping_city":rng.choice(["Zurich","Bern","Basel","Lucerne","Geneva"],n_orders),
        "channel":rng.choice(["web","mobile","marketplace"],n_orders)
    })
    campaigns=pd.DataFrame({
        "campaign_id":range(1,7),
        "campaign_name":[f"Campaign {i}" for i in range(1,7)],
        "start_date":pd.date_range("2025-01-01",periods=6,freq="60D"),
        "end_date":pd.date_range("2025-02-15",periods=6,freq="60D"),
        "channel":["email","social","paid","email","social","paid"],
        "target_segment":["Standard","Premium","VIP","Standard","Premium","VIP"]
    })
    return customers, products, orders, campaigns

def prepare_base_data(target_dir):
    import pandas as pd
    (target_dir/"data").mkdir(parents=True, exist_ok=True)
    wb=find_workbook()
    try:
        if wb:
            kunden=pd.read_excel(wb, sheet_name="Kunden")
            produkte=pd.read_excel(wb, sheet_name="Produkte")
            bestellungen=pd.read_excel(wb, sheet_name="Bestellungen")
            kampagnen=pd.read_excel(wb, sheet_name="Kampagnen")
        else:
            raise RuntimeError
    except Exception:
        kunden, produkte, bestellungen, kampagnen=_synthetic_shop_data()

    transactions=pd.DataFrame({
        "Customer":bestellungen["customer_id"],
        "TransDate":pd.to_datetime(bestellungen["order_date"], errors="coerce"),
        "Quantity":pd.to_numeric(bestellungen["quantity"], errors="coerce"),
        "PurchAmount":pd.to_numeric(bestellungen["net_amount_chf"], errors="coerce"),
        "Cost":pd.to_numeric(bestellungen["discount_chf"], errors="coerce").fillna(0)
              +pd.to_numeric(bestellungen["shipping_chf"], errors="coerce").fillna(0),
        "Channel":bestellungen.get("channel", pd.Series(["online"]*len(bestellungen))).astype(str)
    })
    transactions["Year"]=transactions["TransDate"].dt.year
    cust=pd.DataFrame({
        "Customer":kunden["customer_id"],
        "CustId":kunden["customer_id"],
        "Store":kunden.get("acquisition_channel", pd.Series(["online"]*len(kunden))).astype(str),
        "JoinDate":pd.to_datetime(kunden.get("registration_date"), errors="coerce")
    })

    A=pd.DataFrame({
        "ID":[1,2,3,4],
        "TransDate":pd.to_datetime(["2025-01-01","2025-01-02","2025-01-03","2025-01-04"]),
        "ValueA":[10,20,30,40]
    })
    B=pd.DataFrame({
        "ID":[2,3,4,5],
        "TransDate":pd.to_datetime(["2025-01-02","2025-01-03","2025-01-04","2025-01-05"]),
        "ValueB":[200,300,400,500]
    })

    transactions.to_csv(target_dir/"data"/"transactions.csv", index=False)
    transactions.to_csv(target_dir/"transactions.csv", index=False)
    kunden.to_csv(target_dir/"customers.csv", index=False)
    produkte.to_csv(target_dir/"products.csv", index=False)

    import sqlite3
    con=sqlite3.connect(target_dir/"database.sqlite")
    transactions.to_sql("transactions", con, if_exists="replace", index=False)
    cust.to_sql("CustData", con, if_exists="replace", index=False)
    A.to_sql("A", con, if_exists="replace", index=False)
    B.to_sql("B", con, if_exists="replace", index=False)
    A.to_sql("X", con, if_exists="replace", index=False)
    B.to_sql("Y", con, if_exists="replace", index=False)
    pd.DataFrame({"ID":[1],"Value":["demo"]}).to_sql("new_table", con, if_exists="replace", index=False)
    con.commit()
    con.close()

def adapt_code(code):
    c=code
    c=c.replace("filepath_or_buüer", '"data/transactions.csv"')
    c=c.replace("filepath_or_buffer", '"data/transactions.csv"')
    c=c.replace('path_or_buf="file.csv"', '"output.csv"')
    c=c.replace("path_or_buf='file.csv'", '"output.csv"')
    c=c.replace("package.function", "np.sum")
    c=c.replace('myData["Spalte1"]', 'myData["PurchAmount"]')
    c=c.replace('myData["Spalte2"]', 'myData["Cost"]')
    c=c.replace('myData["Spalte"]', 'myData["PurchAmount"]')
    c=c.replace('myData["column_name"]', 'myData["Customer"]')
    c=c.replace("row_index", "0")
    c=c.replace("dayﬁrst", "dayfirst")
    c=c.replace("zﬁll", "zfill")
    # Current pandas: DataFrame.append() was removed. The game uses concat only in the old append example.
    c=c.replace(
        'myData.append(pd.DataFrame([[...]], columns=myData.columns.values), ignore_index=True)',
        'myData = pd.concat([myData, pd.DataFrame([[1001, pd.Timestamp("2025-01-01"), 1, 10.0, 2.0, "web", 2025]], columns=myData.columns)], ignore_index=True)'
    )
    c=c.replace("variableName = (...)", "variableName = 42")
    # Placeholder expressions in plotting examples.
    c=re.sub(r'plt\.plot\(x,\s*y,', 'plt.plot(myData["PurchAmount"].head(20), myData["Cost"].head(20),', c)
    c=re.sub(r'plt\.text\(x,\s*y,', 'plt.text(100, 50,', c)
    c=c.replace("plt.xlim(min, max)", "plt.xlim(0,500)")
    c=c.replace("plt.ylim(min, max)", "plt.ylim(0,500)")
    stripped=c.strip()
    if stripped.startswith(("SELECT ","INSERT INTO ","ALTER TABLE ","DROP TABLE ")):
        if stripped.startswith("SELECT "):
            return "query=" + repr(stripped) + "\nresult=pd.read_sql_query(query, con)\nprint(result.to_string(index=False))"
        return "cursor.execute(" + repr(stripped) + ")\ncon.commit()\nprint('OK')"
    return c

def runner_prelude():
    return r"""
